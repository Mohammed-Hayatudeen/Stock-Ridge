# Copy to .env.deploy for local Turso administration. Never commit the copy.
TURSO_DATABASE_URL=https://your-database.turso.io
TURSO_AUTH_TOKEN=
# Configure these as Worker secrets, not in worker/wrangler.toml:
# npx wrangler secret put TURSO_AUTH_TOKEN --config worker/wrangler.toml
# npx wrangler secret put JWT_SECRET --config worker/wrangler.toml
